{
  "name": "masterportal",
  "private": true,
  "type": "module",
  "author": {
    "name": "Implementierungspartnerschaft Masterportal",
    "email": "info@masterportal.org",
    "url": "https://www.masterportal.org"
  },
  "bugs": "https://bitbucket.org/geowerkstatt-hamburg/masterportal/issues",
  "version": "3.19.0",
  "license": "MIT",
  "description": "The MasterPortal as OpenSource Geoportal",
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/geowerkstatt-hamburg/masterportal.git"
  },
  "main": "src/masterportal.js",
  "scripts": {
    "prestart": "node devtools/certificate/ensureDevCert.mjs",
    "start": "vite --config devtools/vite.config.js",
    "startDebug": "vite --config devtools/vite.config.js  --debug plugin-transform",
    "test": "rm -rf node_modules/.vite && vitest run --config devtools/vitest.config.js",
    "test:watch": "rm -rf node_modules/.vite && vitest --config devtools/vitest.config.js --watch",
    "test:silent": "rm -rf node_modules/.vite && cross-env SILENT=true vitest  run --config devtools/vitest.config.js",
    "test:silent:watch": "rm -rf node_modules/.vite && cross-env SILENT=true vitest --config devtools/vitest.config.js --watch",
    "lint": "eslint \"./**/*.{vue,js}\"",
    "lint:fix": "eslint --fix \"./**/*.{vue,js}\"",
    "migrateConfig": "node devtools/tasks/migrator/migrate.js",
    "build": "node devtools/tasks/viteBuild.js",
    "buildPortal": "vite build --config devtools/vite.config.js && rm -rf dist/portal",
    "buildExamples": "cross-env EXAMPLES_ONLY=true vite build --config devtools/vite.config.js --mode production && rm -rf dist/portal dist/build dist/examples_*",
    "buildJsDoc": "node devtools/tasks/buildJsDoc.js",
    "versionHotfix": "npm version patch && npm run versionLatest && git tag -d lts && git push --tags -f --no-verify",
    "versionMinor": "npm version minor && npm run versionLatest && git tag -d lts && git push --tags -f --no-verify",
    "versionMajor": "npm version major && npm run versionLatest && git tag -d lts && git push --tags -f --no-verify",
    "versionLatest": "git tag latest -f",
    "versionHotfix:all": "npm run versionHotfix && cd addons && npm run versionHotfix && cd .. && cd portalconfigs && npm run versionHotfix && cd ..",
    "versionMinor:all": "npm run versionMinor && cd addons && npm run versionMinor && cd .. && cd portalconfigs && npm run versionMinor && cd ..",
    "versionMajor:all": "npm run versionMajor && cd addons && npm run versionMajor && cd .. && cd portalconfigs && npm run versionMajor && cd ..",
    "prePushHook": "node ./node_modules/@masterportal/mpconfigparser/cli.js docs/User/Portal-Config/config.json.md docs/User/Portal-Config/config.json.de.md && eslint --max-warnings 0 \"./**/*.{vue,js}\" && npm run test",
    "validateDocs": "node devtools/docsValidation/validateDocs.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@masterportal/masterportalapi": "git+https://bitbucket.org/geowerkstatt-hamburg/masterportalapi.git#master",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.12.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.0",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "i18next-vue": "^4.0.0",
    "jsts": "^2.12.1",
    "mqtt": "^5.14.1",
    "object-hash": "^3.0.0",
    "qrcode": "1.5.4",
    "three": "^0.180.0",
    "url-parse": "^1.5.10",
    "vue": "^3.5.22",
    "vue-datepicker-next": "^1.0.3",
    "vue-matomo": "^4.2.0",
    "vue-multiselect": "3.2.0",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@geoblocks/print": "^0.7.9",
    "@masterportal/mpconfigparser": "^2.0.0",
    "@sinonjs/fake-timers": "^14.0.0",
    "@stylistic/eslint-plugin-js": "^2.13.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vitest/ui": "^4.0.16",
    "@vitest/web-worker": "^4.0.16",
    "@vue/compiler-sfc": "3.5.22",
    "@vue/devtools-api": "^7.7.2",
    "@vue/server-renderer": "3.5.22",
    "@vue/test-utils": "^2.4.6",
    "canvas": "^3.2.0",
    "chai": "^5.2.0",
    "child-process-promise": "^2.2.1",
    "cross-env": "^10.1.0",
    "esbuild-loader": "^4.4.2",
    "eslint-plugin-jsdoc": "50.6.3",
    "eslint-plugin-n": "17.10.2",
    "eslint-plugin-vue": "9.32.0",
    "eslint-plugin-vuejs-accessibility": "2.4.1",
    "fs-extra": "^11.3.0",
    "git-rev-sync": "^3.0.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdoc": "4.0.4",
    "jsdoc-vuejs": "^4.0.0",
    "jsdom": "^26.0.0",
    "jsdom-worker": "^0.3.0",
    "mock-local-storage": "^1.1.24",
    "regenerator-runtime": "^0.14.1",
    "replace-in-file": "8.3.0",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "1.77.2",
    "shelljs": "^0.8.5",
    "sinon": "19.0.2",
    "sinon-chai": "^4.0.0",
    "text-loader": "^0.0.1",
    "vite": "^7.3.0",
    "vite-plugin-cp": "^6.0.3",
    "vite-plugin-dynamic-import": "^1.6.0",
    "vite-plugin-html-purgecss": "^0.1.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.0.16",
    "xmlserializer": "^0.6.1"
  },
  "overrides": {
    "@cesium/engine": "npm:dry-uninstall",
    "@cesium/widgets": "npm:dry-uninstall"
  },
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": "^10.5.0"
  }
}
