# GitHub Copilot Ignore File
# Patterns listed here are excluded from Copilot's context analysis

## Excluded content in Github for Organizations

# Dependencies
node_modules/
addons/node_modules/
addons/**/node_modules/

# Portal instance & config (not core code)
portalconfigs/

# Build outputs & generated files
dist/
jsdoc/
site/

# Git directory
.git/

# Ignore Python virtual environment
.venv/*

## Excluded only in Project itself

# Sensitive environment & configuration files
.env
.history/
devtools/proxyconf.json
devtools/proxyconf_example.json
devtools/securedServices.js
devtools/certificate/
devtools/security/
devtools/tests/
devtools/tasks/

# IDE & editor caches (duplicates of source)
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sass-cache
.vscode/

# Test coverage reports
coverage/

# Generated/minified files
**/*.min.js

# CI/CD configuration
 .gitlab/
 .husky/